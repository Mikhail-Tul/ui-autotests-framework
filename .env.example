# Конфигурация тестового окружения.
# Скопируйте этот файл как .env и заполните значения под свой стенд.
# Файл .env находится в .gitignore и никогда не попадает в репозиторий.

# === Подключение к стенду ===

# Адрес тестируемого приложения
UITEST_BASE_URL=https://stand.example.com

# Учётная запись тестового пользователя.
# Оставьте пустыми, если приложение не требует авторизации.
UITEST_LOGIN=
UITEST_PASSWORD=

# === Внутренние эндпоинты ===
#
# Адреса внутренних эндпоинтов вынесены из исходного кода в окружение:
# это часть контракта конкретной системы, а не универсальный код.
# Пути начинаются с «/».

# Эндпоинт получения актуальных UID объектов модели
UITEST_OBJECT_MODELS_API_PATH=

# Эндпоинт выполнения серверного скрипта. {modelUid} подставляется автоматически.
UITEST_EXECUTE_SCRIPT_API_PATH=

# Эндпоинт смены
UITEST_SHIFT_CHANGE_API_PATH=

# === Персональные данные тестового сотрудника ===
#
# Используются как ключ поиска в справочниках системы при подготовке
# тестовых данных, поэтому должны совпадать с реальными значениями на стенде.

UITEST_PERSON_NAME=Иванов Иван Иванович
UITEST_PERSON_DEPARTMENT=Эксплуатационное подразделение
UITEST_SHIFT_ROLE=Дежурный персонал

# === Прочие настройки ===

# Произвольный текст для проверки полей ввода
UITEST_TEXT_PATTERN=Проверка ввода автотеста 1234

# Запуск браузера без окна: true / false
UITEST_HEADLESS=false